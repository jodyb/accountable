    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^9.3.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.79.0",
